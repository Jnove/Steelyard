          "enum": [
            "BJ",
            "TJ",
            "HE",
            "SX",
            "NM",
            "LN",
            "JL",
            "HL",
            "SH",
            "JS",
            "ZJ",
            "AH",
            "FJ",
            "JX",
            "SD",
            "HA",
            "HB",
            "HN",
            "GD",
            "GX",
            "HI",
            "CQ",
            "SC",
            "GZ",
            "YN",
            "XZ",
            "SN",
            "GS",
            "QH",
            "NX",
            "XJ"
          ],
          "group": "基本信息",
          "label": "所在省份",
          "title": "Province",
          "unit": "—"
        },
        "standard_packs": {
          "allow_custom_options": false,
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "适用的规则册；留空＝只用国家标准（GB）。GB 永远生效、不能去掉；加进省级地区码后，该省的地方规则才会参与评估",
          "empty_means_unknown": true,
          "group": "基本信息",
          "label": "适用标准册",
          "options": [
            "GB",
            "BJ",
            "TJ",
            "HE",
            "SX",
            "NM",
            "LN",
            "JL",
            "HL",
            "SH",
            "JS",
            "ZJ",
            "AH",
            "FJ",
            "JX",
            "SD",
            "HA",
            "HB",
            "HN",
            "GD",
            "GX",
            "HI",
            "CQ",
            "SC",
            "GZ",
            "YN",
            "XZ",
            "SN",
            "GS",
            "QH",
            "NX",
            "XJ"
          ],
          "required_options": [
            "GB"
          ],
          "title": "Standard Packs",
          "unit": "—"
        },
        "project_notes": {
          "anyOf": [
            {
              "maxLength": 12000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "项目资料出处、真实资料与教学假设的边界；仅作案例说明，不参与评分",
          "group": "基本信息",
          "label": "案例来源与边界",
          "title": "Project Notes",
          "unit": "—"
        },
        "scoring_exclusions": {
          "allow_custom_options": false,
          "description": "本项目暂不纳入评分的代理指标；仅允许 G-05、Q-05、Q-06，不能关闭硬约束。应在案例来源与边界中记录原因、资料依据和核对人；不适用项不参与维度均值。",
          "group": "基本信息",
          "items": {
            "enum": [
              "G-05",
              "Q-05",
              "Q-06"
            ],
            "type": "string"
          },
          "label": "暂不纳入评分的代理指标",
          "options": [
            "G-05",
            "Q-05",
            "Q-06"
          ],
          "title": "Scoring Exclusions",
          "type": "array",
          "unit": "—"
        }
      },
      "title": "ProjectParams",
      "type": "object"
    }
  },
  "description": "项目读取响应。",
  "properties": {
    "id": {
      "title": "Id",
      "type": "integer"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "params": {
      "$ref": "#/$defs/ProjectParams"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "params",
    "created_at",
    "updated_at"
  ],
