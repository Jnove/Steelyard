              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "建筑气候分区",
          "enum": [
            "严寒",
            "寒冷",
            "夏热冬冷",
            "夏热冬暖",
            "温和"
          ],
          "group": "基本信息",
          "label": "气候分区",
          "title": "Climate Zone",
          "unit": "—"
