{
  "$defs": {
    "ProjectParams": {
      "description": "项目层（地块条件）参数，对所有候选方案相同",
      "group_order": [
        "基本信息",
        "居住品质",
        "结构与造价",
        "施工与安全",
        "绿色低碳"
      ],
      "properties": {
        "site_area": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "用地面积",
          "essential": true,
          "group": "基本信息",
          "label": "用地面积",
          "title": "Site Area",
          "unit": "m²"
        },
        "far_max": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "容积率上限（无量纲系数，中国常见 0.5–4.0）",
          "group": "基本信息",
          "label": "容积率上限",
          "title": "Far Max",
          "unit": "—"
        },
        "density_max": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "建筑密度上限（小数，0.30 = 30%）",
          "group": "基本信息",
          "label": "建筑密度上限",
          "title": "Density Max",
          "unit": "—"
        },
        "height_max": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "建筑限高上限",
          "group": "基本信息",
          "label": "限高上限",
          "title": "Height Max",
          "unit": "m"
        },
        "climate_zone": {
          "anyOf": [
            {
              "enum": [
                "严寒",
                "寒冷",
                "夏热冬冷",
                "夏热冬暖",
                "温和"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "建筑气候分区",
          "enum": [
            "严寒",
            "寒冷",
            "夏热冬冷",
            "夏热冬暖",
            "温和"
          ],
          "group": "基本信息",
          "label": "气候分区",
          "title": "Climate Zone",
          "unit": "—"
        },
        "seismic_intensity": {
          "anyOf": [
            {
              "enum": [
                "6度(0.05g)",
                "7度(0.10g)"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "抗震设防烈度（浙江全省最高为 7 度 0.10g）",
          "enum": [
            "6度(0.05g)",
            "7度(0.10g)"
          ],
          "group": "基本信息",
          "label": "抗震设防烈度",
          "title": "Seismic Intensity",
          "unit": "—"
        },
        "province": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
