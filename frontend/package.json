{
  "name": "zhuheng-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "gen:types": "node scripts/gen-types.mjs",
    "sync:mock": "node scripts/sync-mock.mjs",
    "dev:mock": "vite --mode mock",
    "build:mock": "tsc --noEmit && vite build --mode mock",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs src/mocks/data-layer.test.mjs",
    "test:ui": "node scripts/verify-ui.mjs",
    "test:homepage": "node scripts/verify-homepage.mjs",
    "test:workbench": "node scripts/verify-workbench.mjs",
    "test:integration": "node scripts/verify-integration.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-table": "8.21.3",
    "antd": "^5.20.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "echarts": "^5.5.0",
    "echarts-for-react": "^3.0.2",
    "lucide-react": "1.61.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "7.90.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.26.0",
    "tailwind-merge": "3.7.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "^4.3.0",
    "json-schema-to-typescript": "^15.0.4",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
