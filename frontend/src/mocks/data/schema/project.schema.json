      "unit": "m²",
      "group": "基本信息",
      "type": "number",
      "required": false,
      "constraints": {},
      "essential": true
    },
    {
      "name": "far_max",
      "label": "容积率上限",
      "description": "容积率上限（无量纲系数，中国常见 0.5–4.0）",
      "unit": "—",
      "group": "基本信息",
      "type": "number",
      "required": false,
      "constraints": {}
    },
    {
      "name": "density_max",
      "label": "建筑密度上限",
      "description": "建筑密度上限（小数，0.30 = 30%）",
      "unit": "—",
      "group": "基本信息",
      "type": "number",
      "required": false,
      "constraints": {}
    },
    {
      "name": "height_max",
