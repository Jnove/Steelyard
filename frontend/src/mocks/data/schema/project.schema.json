      "label": "气候分区",
      "description": "建筑气候分区",
      "unit": "—",
      "group": "基本信息",
      "type": "string",
      "required": false,
      "constraints": {},
      "enum": [
        "严寒",
        "寒冷",
        "夏热冬冷",
        "夏热冬暖",
        "温和"
      ]
    },
    {
      "name": "seismic_intensity",
      "label": "抗震设防烈度",
