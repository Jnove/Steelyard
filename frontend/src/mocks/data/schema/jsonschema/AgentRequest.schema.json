{
  "$defs": {
    "HistoryMessage": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        },
        "content": {
          "maxLength": 30000,
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "HistoryMessage",
      "type": "object"
    },
    "SchemeChange": {
      "additionalProperties": false,
      "properties": {
        "scheme_id": {
          "exclusiveMinimum": 0,
          "title": "Scheme Id",
          "type": "integer"
        },
        "field": {
          "title": "Field",
          "type": "string"
        },
        "value": {
          "title": "Value"
        }
      },
      "required": [
        "scheme_id",
        "field",
        "value"
      ],
      "title": "SchemeChange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "message": {
      "default": "生成方案比选报告",
      "maxLength": 30000,
      "title": "Message",
      "type": "string"
    },
    "history": {
      "items": {
        "$ref": "#/$defs/HistoryMessage"
      },
      "maxItems": 50,
      "title": "History",
      "type": "array"
    },
    "intent": {
      "anyOf": [
        {
          "enum": [
            "new_eval",
            "whatif",
            "explain",
            "reweight"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Intent"
    },
    "role": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Role"
    },
    "weights": {
      "anyOf": [
        {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Weights"
    },
    "include_whatif": {
      "default": false,
      "title": "Include Whatif",
      "type": "boolean"
    },
    "change": {
      "anyOf": [
        {
          "$ref": "#/$defs/SchemeChange"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "rule_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rule Id"
    },
    "scheme_id": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scheme Id"
    }
  },
  "title": "AgentRequest",
  "type": "object"
}