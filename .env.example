# 复制为 .env 后按需修改；.env 已被 git 忽略
# 所有字段都可通过环境变量覆盖

# 运行环境：dev 或 prod。dev 才开放 POST /api/rules/reload 这类调试接口
APP_ENV=dev

# LLM 配置：默认 fake 桩，本地无 Key 也能跑
LLM_PROVIDER=fake
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 默认数据库为当前工作树 backend/data/zhuheng.db，seed 与服务不受 CWD 影响。
# 覆盖时建议使用绝对路径；显式配置的相对路径仍相对于进程 CWD。
# DATABASE_URL=sqlite:///D:/path/to/project/backend/data/zhuheng.db

# CORS：逗号分隔多个来源，开发环境默认 Vite dev server
CORS_ORIGINS=http://localhost:5173
